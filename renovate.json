{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":dependencyDashboard",
        ":semanticCommits",
        "helpers:pinGitHubActionDigests"
    ],
    "enabledManagers": [
        "pep621",
        "github-actions",
        "pre-commit"
    ],
    "pre-commit": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "before 5am on monday"
        ]
    },
    "packageRules": [
        {
            "description": "Advance org reusable-workflow SHA pins to the latest semver release tag (mirrors ByronWilliamsCPA/.github renovate.json). No followTag: org vX.Y.Z tags are immutable and there is no floating major tag.",
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "/^ByronWilliamsCPA\\/\\.github/",
                "/^williaby\\/\\.github/"
            ],
            "versioning": "semver"
        },
        {
            "description": "Vulnerability fixes: immediate individual PRs",
            "matchJsonata": [
                "isVulnerabilityAlert = true"
            ],
            "groupName": null,
            "labels": [
                "vulnerability",
                "priority:critical"
            ],
            "prPriority": 15,
            "schedule": [
                "at any time"
            ],
            "minimumReleaseAge": "0 days"
        },
        {
            "description": "Routine Python patch and minor updates: monthly batch",
            "matchManagers": [
                "pep621"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "groupName": "python-routine-updates",
            "labels": [
                "batched-updates"
            ],
            "schedule": [
                "on the first day of the month"
            ]
        },
        {
            "description": "Major updates always require manual review",
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "requires-review",
                "scope:major"
            ],
            "reviewers": [
                "williaby"
            ]
        },
        {
            "description": "GitHub Actions and pre-commit hooks: pinned digests, monthly batch",
            "matchManagers": [
                "github-actions",
                "pre-commit"
            ],
            "matchPackageNames": [
                "!/^ByronWilliamsCPA\\/\\.github/",
                "!/^williaby\\/\\.github/"
            ],
            "groupName": "ci-tooling",
            "labels": [
                "github-actions"
            ],
            "schedule": [
                "on the first day of the month"
            ]
        }
    ],
    "prConcurrentLimit": 3,
    "rangeStrategy": "bump",
    "semanticCommits": "enabled",
    "timezone": "UTC",
    "schedule": [
        "after 3am and before 5am every weekday",
        "every weekend"
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": [
            "security"
        ],
        "assignees": [
            "williaby"
        ]
    },
    "osvVulnerabilityAlerts": true,
    "platformAutomerge": false
}
