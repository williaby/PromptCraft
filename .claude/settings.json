{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make security)",
      "Bash(make docs)",
      "Bash(make check)",
      "Bash(make pre-commit)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run --frozen pytest:*)",
      "Bash(uv run --frozen ruff:*)",
      "Bash(uv run --frozen basedpyright:*)",
      "Bash(uv run --frozen pre-commit:*)",
      "Bash(uv run --frozen nox:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list)"
    ]
  }
}
