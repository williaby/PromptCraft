{
  "project": {
    "name": "PromptCraft",
    "type": "python",
    "languages": ["python", "javascript"]
  },
  "tools": {
    "enabled": ["basic_commands"],
    "disabled": []
  },
  "subagentModels": {
    "Explore": "haiku",
    "Plan": "inherit",
    "general-purpose": "sonnet",
    "code-reviewer": "sonnet",
    "security-auditor": "sonnet",
    "documentation-writer": "sonnet",
    "test-engineer": "sonnet",
    "_comment": "Preference for built-in and common subagents per global standards. Opus is used only for complex reasoning, planning, and architecture decisions."
  },
  "permissions": {
    "allow": [
      "Bash(make test*:*)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make pre-commit)",
      "Bash(make security)",
      "Bash(uv run pytest*:*)",
      "Bash(uv run ruff*:*)",
      "Bash(uv run mypy*:*)",
      "Bash(uv run pre-commit*:*)",
      "Bash(uv tree*:*)",
      "Bash(git status*:*)",
      "Bash(git diff*:*)",
      "Bash(git log*:*)",
      "Bash(git branch*:*)",
      "Bash(git worktree list)"
    ]
  }
}
